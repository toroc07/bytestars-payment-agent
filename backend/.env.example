APP_ENV=development
DATABASE_URL=sqlite:///./local.db
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=4
LLM_PROVIDER_ORDER=gemini,groq,openrouter
LLM_CACHE=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free
ADMIN_TOKEN=  # Token opcional para proteger /api/dev/* y aprobaciones en entornos públicos
